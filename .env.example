OPENAI_API_KEY=
# Proveedor de modelo: openai u openrouter.
MODEL_PROVIDER=openai

# Opcional para OpenAI directo.
# OPENAI_MODEL=

# Opcional para OpenRouter.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/openai/gpt-4o-mini

# Seguridad de la API. En Railway se debe configurar obligatoriamente.
# PRENOMINA_API_KEY=

# Limite maximo de archivo en MB.
MAX_UPLOAD_MB=25

# Criterios auditables para prenomina administrativa.
FONDO_AHORRO_FACTOR=0.11
UMA_DIARIA=117.31
FONDO_AHORRO_TOPE_MODE=mensual
USE_EXCEL_FONDO_AHORRO=true
DIAS_BASE_PERIODO=30.4
